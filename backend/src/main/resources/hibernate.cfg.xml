<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>

    <session-factory>

        <!-- =====================================================
             DATABASE CONNECTION
             ===================================================== -->

        <!-- MySQL Driver -->
        <property name="hibernate.connection.driver_class">
            com.mysql.cj.jdbc.Driver
        </property>


        <!-- Database URL -->
        <property name="hibernate.connection.url">
            jdbc:mysql://localhost:3306/medihouse?useSSL=false&amp;serverTimezone=UTC
        </property>


        <!-- MySQL Username -->
        <property name="hibernate.connection.username">
            root
        </property>


        <!-- MySQL Password -->
        <!-- If your MySQL has a password, put it here -->
        <property name="hibernate.connection.password">
        </property>



        <!-- =====================================================
             HIBERNATE DIALECT
             ===================================================== -->

        <property name="hibernate.dialect">
            org.hibernate.dialect.MySQLDialect
        </property>



        <!-- =====================================================
             DATABASE TABLE MANAGEMENT
             ===================================================== -->

        <!--
            update:
            Hibernate creates missing tables and updates
            the structure without deleting existing data.
        -->

        <property name="hibernate.hbm2ddl.auto">
            update
        </property>



        <!-- =====================================================
             SQL DISPLAY
             ===================================================== -->

        <!-- Show SQL queries in VS Code terminal -->
        <property name="hibernate.show_sql">
            true
        </property>


        <!-- Format SQL queries -->
        <property name="hibernate.format_sql">
            true
        </property>


        <!-- Show SQL comments -->
        <property name="hibernate.use_sql_comments">
            true
        </property>



        <!-- =====================================================
             CONNECTION POOL
             ===================================================== -->

        <property name="hibernate.connection.pool_size">
            5
        </property>



        <!-- =====================================================
             ENTITY MAPPINGS
             ===================================================== -->

        <!-- Patient Entity -->

        <mapping class="com.medihouse.entity.Patient"/>


    </session-factory>

</hibernate-configuration>